# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3000
# Public URL for the server (used for the join-room QR code)
# BASE_URL=http://localhost:3000
# If omitted, local IP will be auto-detected (e.g. http://192.168.1.x:3000)

# ─── Quiz Configuration ───────────────────────────────────────────────────────
# Seconds allowed per question (default: 25)
QUESTION_TIME_LIMIT=21
# Seconds the results screen is shown before auto-advancing (default: 8)
RESULTS_DELAY=7
# Number of questions per session (random subset); omit for all available
QUESTION_COUNT=21
# Question categories to load (comma-separated). Default: bitcoin
# Available: bitcoin, blockchain, mining, lightning, wallets, transactions, channels, lsp, dev
CATEGORIES=bitcoin

# ─── Lightning Payouts ────────────────────────────────────────────────────────
# Sats awarded to the winner per point (used only if LN_ENGINE=none)
SAT_PER_POINT=1

# ─── Pay-to-Play (Pool Mode) ──────────────────────────────────────────────────
# Entry fee per player in sats (0 = Manual mode / legacy behavior)
# Costo de entrada por jugador
ENTRY_FEE_SATS=0
# Pool sats reserved to cover routing fees when sending the prize
# Reserva para fees de red
PAYOUT_FEE_RESERVE_SATS=20

# Lightning Engine to use (LN_ENGINE):
#   - none          : (Default) Free for players. Manual payout by host.
#   - phoenixd      : Phoenix Node (server). Requires phoenixd running.
#   - breez-liquid  : Breez SDK (Liquid). Nodeless, requires Liquid BTC.
#   - mdk           : Money Dev Kit. Cloud, zero-config.
LN_ENGINE=none

# Phoenixd Config
PHOENIXD_URL=http://127.0.0.1:9740
PHOENIXD_API_KEY=

# Breez Liquid Config
BREEZ_API_KEY=
BREEZ_MNEMONIC=
BREEZ_WORKING_DIR=./breez_data

# Money Dev Kit (MDK) Config
MDK_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
#  LEGACY METHODS (Only for LN_ENGINE=none)
# ═══════════════════════════════════════════════════════════════════════════
#  OPTION 1 — NWC  (Nostr Wallet Connect) — RECOMMENDED ✅
#  Compatible with: Alby, Zeus, Bitkit and any NWC wallet
#  Get your connection string at: https://nwc.getalby.com
# ══════════════════════════════════════════════════════════════════════════════
NWC_URL=
# Example: NWC_URL=nostr+walletconnect://your-connection-string-here

# ══════════════════════════════════════════════════════════════════════════════
#  OPTION 2 — LND REST  (for node runners) — ADVANCED
# ══════════════════════════════════════════════════════════════════════════════
LND_REST_URL=
LND_MACAROON=
# Example: LND_REST_URL=https://your-lnd-node:8080
# Example: LND_MACAROON=your-macaroon-in-hex
# LND TLS Certificate in base64 (optional; if omitted, TLS verification is disabled)
LND_CERT=

# ─── Note ────────────────────────────────────────────────────────────────────
# If no options are configured, the server runs in Manual Mode:
# It displays the sat amount for the host to pay manually from their wallet.
